{
  "name": "@loomwork/schema-migration-planner",
  "version": "0.0.1",
  "description": "Schema Migration Planner: at the approval gate for a large-table schema change, fork the durable execution into mutually-exclusive migration strategies, simulate each against a shadow schema (streaming live backfill progress), compare a git-graph diff, and promote the winner (branch-only, no merge). Demonstrates Loom's git-style branching end-to-end on a durable server (SQLite) with a Web Components client over SSE.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo:fork": "tsx src/scripts/speculativeFork.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "start": "vite build && tsx src/server/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo",
    "dev:worker": "tsx src/compute/main.ts",
    "demo:placement": "tsx src/scripts/branchPlacement.ts"
  },
  "dependencies": {
    "@loomwork/agent": "*",
    "@loomwork/agent-surface": "*",
    "@loomwork/app": "*",
    "@loomwork/blueprint-runtime": "*",
    "@loomwork/capability": "*",
    "@loomwork/core": "*",
    "@loomwork/dispatcher": "*",
    "@loomwork/effect-runtime": "*",
    "@loomwork/event-runtime": "*",
    "@loomwork/intent": "*",
    "@loomwork/llm": "*",
    "@loomwork/planner": "*",
    "@loomwork/plugin-a2a": "*",
    "@loomwork/plugin-sqlite": "*",
    "@loomwork/plugin-worker-remote": "*",
    "@loomwork/plugin-worker-server": "*",
    "@loomwork/projection-runtime": "*",
    "@loomwork/registry": "*",
    "@loomwork/scheduler": "*",
    "@loomwork/sdk": "*",
    "@loomwork/snapshot-runtime": "*",
    "@loomwork/worker-runtime-local": "*",
    "@loomwork/workflow-runtime": "*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loomwork/testing": "*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:"
  }
}
