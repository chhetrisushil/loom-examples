{
  "name": "@loom/agent-swarm",
  "version": "0.0.1",
  "description": "A dynamic agent-swarm wired from a user's intent: a release-audit swarm where IntentRuntime + PlannerRuntime compose a pipeline from a goal, dispatched to a fleet of agent$ agents over the A2A bus, with a DURABLE plan record, a parallel executeGraph fan-out (join), and durable human-in-the-loop sign-off.",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/plugin-a2a": "*",
    "@loom/app": "*",
    "@loom/capability": "*",
    "@loom/core": "*",
    "@loom/dispatcher": "*",
    "@loom/graph-executor": "*",
    "@loom/intent": "*",
    "@loom/llm": "*",
    "@loom/orchestrator": "*",
    "@loom/planner": "*",
    "@loom/worker-runtime-local": "*",
    "@loom/workflow-runtime": "*",
    "zod": "catalog:",
    "@loom/plugin-sqlite": "*"
  },
  "devDependencies": {
    "@loom/testing": "*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
