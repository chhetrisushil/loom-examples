{
  "name": "@loomwork/loom-starter",
  "version": "0.0.1",
  "description": "The canonical new-architecture Loom example: defineConfig + folder convention (loom gen) + effect middleware (retry) + @loomwork/testing + log-as-fixture evals + deploy-simulation + a pluggable compute seam. A compact release-approval workflow that assesses risk, pauses for human approval, and resumes.",
  "private": true,
  "scripts": {
    "gen": "loom gen --dir app",
    "build": "tsc --build",
    "start": "tsx src/main.ts",
    "record:golden": "tsx src/record-golden.ts",
    "eval": "loom eval --dir evals",
    "runs": "loom ls --db .data/events.db",
    "logs": "loom logs --db .data/events.db",
    "health": "loom doctor --config ./loom.config.ts",
    "deploy:check": "loom deploy check --logs .data/logs --config dist/src/deploy.config.js",
    "test": "vitest run",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/agent-surface": "*",
    "@loomwork/app": "*",
    "@loomwork/core": "*",
    "@loomwork/dispatcher": "*",
    "@loomwork/effect-runtime": "*",
    "@loomwork/event-runtime": "*",
    "@loomwork/middleware": "*",
    "@loomwork/projection-runtime": "*",
    "@loomwork/snapshot-runtime": "*",
    "@loomwork/worker-runtime-local": "*",
    "@loomwork/workflow-runtime": "*",
    "zod": "catalog:",
    "@loomwork/plugin-sqlite": "*"
  },
  "devDependencies": {
    "@loomwork/cli": "*",
    "@loomwork/testing": "*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
