{
  "name": "@loom/loom-starter",
  "version": "0.0.1",
  "description": "The canonical new-architecture Loom example: defineConfig + folder convention (loom gen) + effect middleware (retry) + @loom/testing + log-as-fixture evals + deploy-simulation + a pluggable compute seam. A compact release-approval workflow that assesses risk, pauses for human approval, and resumes.",
  "private": true,
  "scripts": {
    "gen": "loom gen --dir app",
    "build": "tsc --build",
    "start": "tsx src/main.ts",
    "record:golden": "tsx src/record-golden.ts",
    "eval": "loom eval --dir evals",
    "deploy:check": "loom deploy check --logs .data/logs --config dist/src/deploy.config.js",
    "test": "vitest run",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/app": "*",
    "@loom/core": "*",
    "@loom/dispatcher": "*",
    "@loom/effect-runtime": "*",
    "@loom/event-runtime": "*",
    "@loom/middleware": "*",
    "@loom/projection-runtime": "*",
    "@loom/snapshot-runtime": "*",
    "@loom/worker-runtime-local": "*",
    "@loom/workflow-runtime": "*",
    "zod": "catalog:",
    "@loom/plugin-sqlite": "*"
  },
  "devDependencies": {
    "@loom/cli": "*",
    "@loom/testing": "*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vitest": "catalog:"
  }
}
