    "@loomwork/capability": "*",
    "@loomwork/core": "*",
    "@loomwork/dispatcher": "*",
    "@loomwork/effect-runtime": "*",
    "@loomwork/event-runtime": "*",
    "@loomwork/intent": "*",
    "@loomwork/llm": "*",
    "@loomwork/orchestrator": "*",
    "@loomwork/planner": "*",
    "@loomwork/projection-runtime": "*",
    "@loomwork/registry": "*",
    "@loomwork/plugin-renderer-react": "*",
    "@loomwork/sdk": "*",
    "@loomwork/snapshot-runtime": "*",
    "@loomwork/worker-runtime-local": "*",
