    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/plugin-a2a": "*",
    "@loom/agent-surface": "*",
    "@loom/agent": "*",
    "@loom/app": "*",
    "@loom/blueprint-runtime": "*",
    "@loom/capability": "*",
    "@loom/core": "*",
    "@loom/dispatcher": "*",
    "@loom/effect-runtime": "*",
    "@loom/event-runtime": "*",
    "@loom/intent": "*",
    "@loom/llm": "*",
    "@loom/orchestrator": "*",
    "@loom/planner": "*",
    "@loom/projection-runtime": "*",
    "@loom/registry": "*",
    "@loom/plugin-renderer-react": "*",
    "@loom/sdk": "*",
    "@loom/snapshot-runtime": "*",
    "@loom/worker-runtime-local": "*",
    "@loom/workflow-runtime": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loom/compiler": "*",
    "@loom/testing": "*",
    "@types/node": "catalog:",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:"
  }
