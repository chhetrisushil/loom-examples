{
  "name": "@loom/db-observability",
  "version": "0.0.1",
  "description": "A dynamic database-observability dashboard: a user's natural-language question is analysed by an agent, categorised into a topic + a WHAT (the direct answer) and WHY (the supporting explanation), and a Loom blueprint UI is GENERATED DYNAMICALLY from an available widget catalogue bound to live telemetry projections. Renders headlessly via renderer-terminal AND as a React dashboard (Recharts) via renderer-react — the same blueprint, two surfaces.",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/blueprint-runtime": "*",
    "@loom/core": "*",
    "@loom/effect-runtime": "*",
    "@loom/event-runtime": "*",
    "@loom/llm": "*",
    "@loom/orchestration": "*",
    "@loom/plugin-content": "*",
    "@loom/plugin-durable-state": "*",
    "@loom/plugin-mcp": "*",
    "@loom/plugin-renderer-react": "*",
    "@loom/plugin-renderer-terminal": "*",
    "@loom/plugin-sandbox": "*",
    "@loom/projection-runtime": "*",
    "@loom/snapshot-runtime": "*",
    "@loom/workflow-runtime": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:"
  }
}
