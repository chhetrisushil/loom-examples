{
  "name": "@loom/db-command-center-wc",
  "version": "0.0.1",
  "description": "Agentic Database Command Center rendered with vanilla Web Components — no React, no Angular. Same Loom agentic backend, a Custom-Elements BYOR/BYOC render layer.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/plugin-a2a": "*",
    "@loom/a2ui": "*",
    "@loom/agent": "*",
    "@loom/app": "*",
    "@loom/blueprint-runtime": "*",
    "@loom/capability": "*",
    "@loom/core": "*",
    "@loom/dispatcher": "*",
    "@loom/effect-runtime": "*",
    "@loom/event-runtime": "*",
    "@loom/intent": "*",
    "@loom/llm": "*",
    "@loom/planner": "*",
    "@loom/projection-runtime": "*",
    "@loom/registry": "*",
    "@loom/sdk": "*",
    "@loom/snapshot-runtime": "*",
    "@loom/worker-runtime-local": "*",
    "@loom/workflow-runtime": "*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loom/testing": "*",
    "@types/node": "catalog:",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:",
    "jsdom": "^25.0.0"
  }
}
