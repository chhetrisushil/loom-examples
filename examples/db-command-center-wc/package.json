{
  "name": "@loomwork/db-command-center-wc",
  "version": "0.0.1",
  "description": "Agentic Database Command Center rendered with vanilla Web Components — no React, no Angular. Same Loom agentic backend, a Custom-Elements BYOR/BYOC render layer.",
