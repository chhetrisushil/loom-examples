{
  "name": "@loom/cloud-command-center",
  "version": "0.0.1",
  "description": "Cloud Database Command Center — reference application for the Loom framework",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --reporter=verbose test/e2e",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/a2ui": "*",
    "@loom/agent": "*",
    "@loom/app": "*",
    "@loom/blueprint-runtime": "*",
    "@loom/capability": "*",
    "@loom/intent": "*",
    "@loom/core": "*",
    "@loom/effect-runtime": "*",
    "@loom/event-runtime": "*",
    "@loom/llm": "*",
    "@loom/projection-runtime": "*",
    "@loom/plugin-renderer-react": "*",
    "@loom/sdk": "*",
    "@loom/snapshot-runtime": "*",
    "@loom/workflow-runtime": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "catalog:",
    "@loom/plugin-sqlite": "*"
  },
  "devDependencies": {
    "@loom/compiler": "*",
    "@loom/testing": "*",
    "@types/node": "catalog:",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:"
  }
}
