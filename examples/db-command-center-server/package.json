{
  "name": "@loomwork/db-command-center-server",
  "version": "0.0.1",
  "description": "DB Command Center as a server + client app: durable Loom runtime on a Node server (SQLite), a Web Components client rendering over HTTP + SSE. Demonstrates Loom's isomorphic deployment model.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo:fork": "tsx src/scripts/speculativeFork.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "start": "vite build && tsx src/server/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loomwork/plugin-a2a": "*",
    "@loomwork/agent-surface": "*",
    "@loomwork/agent": "*",
    "@loomwork/app": "*",
    "@loomwork/blueprint-runtime": "*",
    "@loomwork/capability": "*",
    "@loomwork/core": "*",
    "@loomwork/dispatcher": "*",
    "@loomwork/effect-runtime": "*",
    "@loomwork/event-runtime": "*",
    "@loomwork/intent": "*",
    "@loomwork/llm": "*",
    "@loomwork/planner": "*",
    "@loomwork/projection-runtime": "*",
    "@loomwork/registry": "*",
    "@loomwork/sdk": "*",
    "@loomwork/snapshot-runtime": "*",
    "@loomwork/worker-runtime-local": "*",
    "@loomwork/workflow-runtime": "*",
    "zod": "catalog:",
    "@loomwork/plugin-sqlite": "*"
  },
  "devDependencies": {
    "@loomwork/testing": "*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:"
  }
}
