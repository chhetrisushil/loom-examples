{
  "name": "@loom/db-command-center-server",
  "version": "0.0.1",
  "description": "DB Command Center as a server + client app: durable Loom runtime on a Node server (SQLite), a Web Components client rendering over HTTP + SSE. Demonstrates Loom's isomorphic deployment model.",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo:fork": "tsx src/scripts/speculativeFork.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc --build",
    "build:ui": "tsc --build && vite build",
    "start": "vite build && tsx src/server/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist .data tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@loom/plugin-a2a": "*",
    "@loom/agent-surface": "*",
    "@loom/agent": "*",
    "@loom/app": "*",
    "@loom/blueprint-runtime": "*",
    "@loom/capability": "*",
    "@loom/core": "*",
    "@loom/dispatcher": "*",
    "@loom/effect-runtime": "*",
    "@loom/event-runtime": "*",
    "@loom/intent": "*",
    "@loom/llm": "*",
    "@loom/planner": "*",
    "@loom/projection-runtime": "*",
    "@loom/registry": "*",
    "@loom/sdk": "*",
    "@loom/snapshot-runtime": "*",
    "@loom/worker-runtime-local": "*",
    "@loom/workflow-runtime": "*",
    "zod": "catalog:",
    "@loom/plugin-sqlite": "*"
  },
  "devDependencies": {
    "@loom/testing": "*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "catalog:"
  }
}
