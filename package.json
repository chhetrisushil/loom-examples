      "@loomwork/worker-runtime-local": "link:../loom/packages/worker-runtime-local",
      "@loomwork/workflow-runtime": "link:../loom/packages/workflow-runtime",
      "@loomwork/plugin-linucb": "link:../loom-plugins/plugins/loom-plugin-linucb"
    }
  }
}
