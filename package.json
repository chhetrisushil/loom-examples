{
  "name": "loom-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable examples for the Loom framework. Consumes the sibling ../loom checkout's unpublished @loom/* packages via pnpm.overrides (link:). See AGENTS.md.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@loom/agent": "link:../loom/packages/agent",
      "@loom/agent-surface": "link:../loom/packages/agent-surface",
      "@loom/analytics": "link:../loom/packages/analytics",
      "@loom/app": "link:../loom/packages/app",
      "@loom/blueprint-runtime": "link:../loom/packages/blueprint-runtime",
      "@loom/capability": "link:../loom/packages/capability",
      "@loom/classify": "link:../loom/packages/classify",
      "@loom/cli": "link:../loom/tools/cli",
      "@loom/compiler": "link:../loom/tools/compiler",
      "@loom/core": "link:../loom/packages/core",
      "@loom/dispatcher": "link:../loom/packages/dispatcher",
      "@loom/dst": "link:../loom/tools/dst",
      "@loom/effect-runtime": "link:../loom/packages/effect-runtime",
      "@loom/event-runtime": "link:../loom/packages/event-runtime",
      "@loom/graph-executor": "link:../loom/packages/graph-executor",
      "@loom/intent": "link:../loom/packages/intent",
      "@loom/learning": "link:../loom/packages/learning",
      "@loom/live-query": "link:../loom/packages/live-query",
      "@loom/llm": "link:../loom/packages/llm",
      "@loom/knowledge": "link:../loom/packages/knowledge",
      "@loom/memory": "link:../loom/packages/memory",
      "@loom/middleware": "link:../loom/packages/middleware",
      "@loom/orchestration": "link:../loom/packages/orchestration",
      "@loom/orchestrator": "link:../loom/packages/orchestrator",
      "@loom/planner": "link:../loom/packages/planner",
      "@loom/plugin-a2a": "link:../loom/plugins/a2a",
      "@loom/plugin-a2ui": "link:../loom/plugins/a2ui",
      "@loom/plugin-audit-chain": "link:../loom/plugins/audit-chain",
      "@loom/plugin-cloudrun": "link:../loom/plugins/cloudrun",
      "@loom/plugin-content": "link:../loom/plugins/content",
      "@loom/plugin-durable-state": "link:../loom/plugins/durable-state",
      "@loom/plugin-mcp": "link:../loom/plugins/mcp",
      "@loom/plugin-mcp-app": "link:../loom/plugins/mcp-app",
      "@loom/plugin-read-model": "link:../loom/plugins/read-model",
      "@loom/plugin-renderer-react": "link:../loom/plugins/renderer-react",
      "@loom/plugin-renderer-terminal": "link:../loom/plugins/renderer-terminal",
      "@loom/plugin-sandbox": "link:../loom/plugins/sandbox",
      "@loom/plugin-sqlite": "link:../loom/plugins/sqlite",
      "@loom/plugin-worker-remote": "link:../loom/plugins/worker-remote",
      "@loom/plugin-worker-server": "link:../loom/plugins/worker-server",
      "@loom/projection-runtime": "link:../loom/packages/projection-runtime",
      "@loom/reasoning": "link:../loom/packages/reasoning",
      "@loom/registry": "link:../loom/packages/registry",
      "@loom/replay-vm": "link:../loom/packages/replay-vm",
      "@loom/scheduler": "link:../loom/packages/scheduler",
      "@loom/sdk": "link:../loom/packages/sdk",
      "@loom/snapshot-runtime": "link:../loom/packages/snapshot-runtime",
      "@loom/telemetry": "link:../loom/packages/telemetry",
      "@loom/testing": "link:../loom/tools/testing",
      "@loom/worker-runtime": "link:../loom/packages/worker-runtime",
      "@loom/worker-runtime-local": "link:../loom/packages/worker-runtime-local",
      "@loom/workflow-runtime": "link:../loom/packages/workflow-runtime",
      "loom-plugin-linucb": "link:../loom-plugins/plugins/loom-plugin-linucb"
    }
  }
}
