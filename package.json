{
  "name": "loom-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable examples for the Loom framework. Consumes the sibling ../loom checkout's unpublished @loomwork/* packages via pnpm.overrides (link:). See AGENTS.md.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@loomwork/agent": "link:../loom/packages/agent",
      "@loomwork/agent-surface": "link:../loom/packages/agent-surface",
      "@loomwork/analytics": "link:../loom/packages/analytics",
      "@loomwork/app": "link:../loom/packages/app",
      "@loomwork/blueprint-runtime": "link:../loom/packages/blueprint-runtime",
      "@loomwork/ui-core": "link:../loom-ui/packages/core",
      "@loomwork/ui-hydration": "link:../loom-ui/packages/hydration",
      "@loomwork/ui-learning": "link:../loom-ui/packages/learning",
      "@loomwork/ui-lineage": "link:../loom-ui/packages/lineage",
      "@loomwork/ui-planner": "link:../loom-ui/packages/planner",
      "@loomwork/ui-renderer-lit": "link:../loom-ui/packages/renderer-lit",
      "@loomwork/ui-renderer-terminal": "link:../loom-ui/packages/renderer-terminal",
      "@loomwork/capability": "link:../loom/packages/capability",
      "@loomwork/classify": "link:../loom/packages/classify",
      "@loomwork/cli": "link:../loom/tools/cli",
      "@loomwork/compiler": "link:../loom/tools/compiler",
      "@loomwork/conversation": "link:../loom/packages/conversation",
      "@loomwork/core": "link:../loom/packages/core",
      "@loomwork/dispatcher": "link:../loom/packages/dispatcher",
      "@loomwork/dst": "link:../loom/tools/dst",
      "@loomwork/effect-runtime": "link:../loom/packages/effect-runtime",
      "@loomwork/event-runtime": "link:../loom/packages/event-runtime",
      "@loomwork/graph-executor": "link:../loom/packages/graph-executor",
      "@loomwork/intent": "link:../loom/packages/intent",
      "@loomwork/learning": "link:../loom/packages/learning",
      "@loomwork/live-query": "link:../loom/packages/live-query",
      "@loomwork/llm": "link:../loom/packages/llm",
      "@loomwork/knowledge": "link:../loom/packages/knowledge",
      "@loomwork/memory": "link:../loom/packages/memory",
      "@loomwork/middleware": "link:../loom/packages/middleware",
      "@loomwork/orchestration": "link:../loom/packages/orchestration",
      "@loomwork/orchestrator": "link:../loom/packages/orchestrator",
      "@loomwork/planner": "link:../loom/packages/planner",
      "@loomwork/plugin-a2a": "link:../loom/plugins/a2a",
      "@loomwork/plugin-a2ui": "link:../loom/plugins/a2ui",
      "@loomwork/plugin-audit-chain": "link:../loom/plugins/audit-chain",
      "@loomwork/plugin-cloudrun": "link:../loom/plugins/cloudrun",
      "@loomwork/plugin-content": "link:../loom/plugins/content",
      "@loomwork/plugin-conversation-sse": "link:../loom/plugins/conversation-sse",
      "@loomwork/plugin-durable-state": "link:../loom/plugins/durable-state",
      "@loomwork/plugin-mcp": "link:../loom/plugins/mcp",
      "@loomwork/plugin-mcp-app": "link:../loom/plugins/mcp-app",
      "@loomwork/plugin-read-model": "link:../loom/plugins/read-model",
      "@loomwork/plugin-renderer-react": "link:../loom/plugins/renderer-react",
      "@loomwork/plugin-renderer-terminal": "link:../loom/plugins/renderer-terminal",
      "@loomwork/plugin-sandbox": "link:../loom/plugins/sandbox",
      "@loomwork/plugin-sqlite": "link:../loom/plugins/sqlite",
      "@loomwork/plugin-worker-remote": "link:../loom/plugins/worker-remote",
      "@loomwork/plugin-worker-server": "link:../loom/plugins/worker-server",
      "@loomwork/projection-runtime": "link:../loom/packages/projection-runtime",
      "@loomwork/reasoning": "link:../loom/packages/reasoning",
      "@loomwork/registry": "link:../loom/packages/registry",
      "@loomwork/replay-vm": "link:../loom/packages/replay-vm",
      "@loomwork/scheduler": "link:../loom/packages/scheduler",
      "@loomwork/sdk": "link:../loom/packages/sdk",
      "@loomwork/snapshot-runtime": "link:../loom/packages/snapshot-runtime",
